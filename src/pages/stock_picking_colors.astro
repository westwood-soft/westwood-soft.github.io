---
import { Image } from "astro:assets";
import { YouTube } from "astro-embed";
import Layout from "../layouts/Layout.astro";
import screenshot3 from "../images/screenshot3-0.png";
import screenshot4 from "../images/screenshot4-0.png";
import screenshot5 from "../images/screenshot5-0.png";
import color_list from "../images/colors_list.jpeg";
---

<Layout title="Stock Picking Colors">
  <div class="bg-gray-900">
    <main>
      <!-- Hero section -->
      <div class="relative isolate overflow-hidden">
        <svg
          class="absolute inset-0 -z-10 h-full w-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id="983e3e4c-de6d-4c3f-8d64-b9761d1534cc"
              width="200"
              height="200"
              x="50%"
              y="-1"
              patternUnits="userSpaceOnUse"
            >
              <path d="M.5 200V.5H200" fill="none"></path>
            </pattern>
          </defs>
          <svg x="50%" y="-1" class="overflow-visible fill-gray-800/20">
            <path
              d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z"
              stroke-width="0"></path>
          </svg>
          <rect
            width="100%"
            height="100%"
            stroke-width="0"
            fill="url(#983e3e4c-de6d-4c3f-8d64-b9761d1534cc)"></rect>
        </svg>
        <div
          class="absolute left-[calc(50%-4rem)] top-10 -z-10 transform-gpu blur-3xl sm:left-[calc(50%-18rem)] lg:left-48 lg:top-[calc(50%-30rem)] xl:left-[calc(50%-24rem)]"
          aria-hidden="true"
        >
          <div
            class="aspect-[1108/632] w-[69.25rem] bg-gradient-to-r from-[#80caff] to-[#4f46e5] opacity-20"
            style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
          >
          </div>
        </div>
        <div
          class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:flex lg:px-8 lg:py-40"
        >
          <div class="mx-auto max-w-2xl flex-shrink-0 lg:mx-0 lg:pt-8">
            <img class="h-11" src="/files/logo_small.svg" alt="Westwood logo" />

            <h1
              class="mt-10 text-pretty text-5xl font-semibold tracking-tight text-white sm:text-7xl"
            >
              Stock Picking Colors
            </h1>
            <h2
              class="mt-3 text-pretty text-xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              for Odoo
            </h2>
            <div class="mt-1">
              <span
                class="rounded bg-red-300 px-2 py-1 text-sm font-semibold text-gray-900"
                >16.0</span
              >
              <span
                class="rounded bg-red-300 px-2 py-1 text-sm font-semibold text-gray-900"
                >17.0</span
              >
              <span
                class="rounded bg-red-300 px-2 py-1 text-sm font-semibold text-gray-900"
                >18.0</span
              >
            </div>
            <p
              class="mt-8 text-pretty text-lg font-medium text-gray-400 sm:text-xl/8"
            >
              Simplify your inventory management with Color-Coded Stock
              Pickings.
            </p>
            <div class="mt-10 flex items-center gap-x-6">
              <a
                href="#"
                class="rounded-md bg-indigo-500 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
                >Get started</a
              >
              <a href="#features" class="text-sm/6 font-semibold text-white"
                >Learn more <span aria-hidden="true">→</span></a
              >
            </div>
          </div>
          <div
            class="mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none lg:flex-none xl:ml-32"
          >
            <div class="mx-1 max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
              <Image
                src={screenshot3}
                alt="Stock Picking with red background"
                class="w-[24rem] rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10"
              />
            </div>
            <div class="mx-1 max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
              <Image
                src={screenshot4}
                alt="Stock Picking with orange background"
                class="w-[24rem] rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10"
              />
            </div>
            <div class="mx-1 max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
              <Image
                src={screenshot5}
                alt="Stock Picking with green background"
                class="w-[24rem] rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Feature section -->
      <div
        class="mx-auto mt-32 max-w-7xl px-6 py-3 sm:mt-56 lg:px-8"
        id="features"
      >
        <div class="mx-auto max-w-2xl lg:text-center">
          <h2 class="text-base/7 font-semibold text-indigo-400">Ship Faster</h2>
          <p
            class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-balance"
          >
            Increase Speed and Confidence
          </p>
          <p class="mt-6 text-lg/8 text-gray-300">
            Identify important Stock Picking properties instantly with
            background colors. Never miss relevant information again.
          </p>
        </div>
        <div class="aspect-h-9 aspect-w-16 mx-auto my-9 px-3">
          <YouTube
            title="Watch Stock Picking Colors on YouTube"
            id="x27NRUQ2p6I"
            class="mx-auto max-w-7xl"
          />
        </div>

        <!-- Feature section -->
        <div class="mt-32 sm:mt-56">
          <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl sm:text-center">
              <h2 class="text-base/7 font-semibold text-indigo-400">
                Easy to Configure
              </h2>
              <p
                class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-white sm:text-balance sm:text-5xl"
              >
                Define Custom Colors and Filters
              </p>
              <p class="mt-6 text-lg/8 text-gray-300">
                Enhance visibility and organization with colors for stock
                picking in both the Inventory and Barcode apps.
              </p>
            </div>
          </div>
          <div class="relative overflow-hidden pt-16">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
              <Image
                src={color_list}
                class="mx-auto rounded-xl shadow-2xl ring-1 ring-white/10"
                alt="Stock Picking Color list view"
              />
              <div class="relative" aria-hidden="true">
                <div
                  class="absolute -inset-x-20 bottom-0 bg-gradient-to-t from-gray-900 pt-[30%]"
                >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA section -->
        <div
          class="relative isolate mt-32 px-6 py-32 sm:mt-56 sm:py-40 lg:px-8"
        >
          <svg
            class="absolute inset-0 -z-10 h-full w-full stroke-white/10 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
            aria-hidden="true"
          >
            <defs>
              <pattern
                id="1d4240dd-898f-445f-932d-e2872fd12de3"
                width="200"
                height="200"
                x="50%"
                y="0"
                patternUnits="userSpaceOnUse"
              >
                <path d="M.5 200V.5H200" fill="none"></path>
              </pattern>
            </defs>
            <svg x="50%" y="0" class="overflow-visible fill-gray-800/20">
              <path
                d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z"
                stroke-width="0"></path>
            </svg>
            <rect
              width="100%"
              height="100%"
              stroke-width="0"
              fill="url(#1d4240dd-898f-445f-932d-e2872fd12de3)"></rect>
          </svg>
          <div
            class="absolute inset-x-0 top-10 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl"
            aria-hidden="true"
          >
            <div
              class="aspect-[1108/632] w-[69.25rem] flex-none bg-gradient-to-r from-[#80caff] to-[#4f46e5] opacity-20"
              style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
            >
            </div>
          </div>
          <div class="mx-auto max-w-2xl text-center">
            <h2
              class="text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl"
            >
              Boost Productivity. Start using Stock Picking Colors today and
              streamline your workflow.
            </h2>
            <p class="mx-auto mt-6 max-w-xl text-lg/8 text-gray-300">
              Get it at the Odoo App Store
            </p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
              <a
                href="#"
                class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >Get started</a
              >
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
